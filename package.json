{
  "name": "timeline-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^15.15.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^4.0.18"
  },
  "description": "Build, time and share a production timeline synchronised to a soundtrack. Runs entirely in the browser.",
  "license": "MIT",
  "homepage": "https://github.com/ElProton/timeLineManager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElProton/timeLineManager.git"
  },
  "bugs": {
    "url": "https://github.com/ElProton/timeLineManager/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "timeline",
    "cue-sheet",
    "rundown",
    "show-production",
    "music-sync",
    "react"
  ]
}
